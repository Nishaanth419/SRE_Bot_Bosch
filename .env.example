# 
# SRE Bot  Required Environment Variables
# Copy this file to Azure.env and fill in your real values.
# NEVER commit Azure.env to git  it is listed in .gitignore.
# 

# --- Azure OpenAI ---
AZURE_OPENAI_ENDPOINT="https://<your-resource>.cognitiveservices.azure.com/"
AZURE_OPENAI_API_VERSION="2024-12-01-preview"
AZURE_OPENAI_API_KEY="<your-azure-openai-api-key>"

# Deployment names (must match what is configured in Azure OpenAI Studio)
CHAT_MODEL="gpt-5.4-mini"
EMBED_MODEL="text-embedding-3-small"

# --- Azure AI Search ---
AZURE_SEARCH_ENDPOINT="https://<your-search-resource>.search.windows.net"
AZURE_SEARCH_INDEX="sre-incidents"
AZURE_SEARCH_API_KEY="<your-azure-search-api-key>"

CONFLUENCE_URL=https://knnishaanth.atlassian.net
CONFLUENCE_USER=<your-atlassian-email>
CONFLUENCE_API_TOKEN=<your-api-token>
CONFLUENCE_SPACE_KEYS=PH
CONFLUENCE_INDEX=confluence-kb
